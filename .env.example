# Copy to .env for local work. Never commit .env.
# Cloudflare R2 (the corpus bucket, EU jurisdiction). Read access is enough.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Language model providers for answer generation. Set one; the service runs in evidence-only mode with none.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Langfuse (tracing), when it is added
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
